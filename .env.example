CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_SIGNING_KEY=devteam-jwt-signing-secret-key-production-grade

# Payment Gateways Configuration
# Stripe
STRIPE_PUBLIC_KEY=pk_test_devteam_mock_stripe_key_12345
STRIPE_SECRET_KEY=sk_test_devteam_mock_stripe_key_67890
