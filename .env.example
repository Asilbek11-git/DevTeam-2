# General Configuration
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=devteam-insecure-prod-key-change-in-production-saas-platform-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ais-dev-4jeisl37xozpsxfse6ajoz-649297010031.asia-east1.run.app
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=devteam_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
